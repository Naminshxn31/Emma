        "\\bcustomers?\\b.{0,20}\\basks?\\b.{0,30}\\b(?:detail\\w*|more|deeper|technical)\\b",
        "\\bhow many (?:storeys?|stories|storys?|floors?|levels?)\\b.{0,25}\\b(?:building|buildings|project|tower|it|we|they)\\b"
      ],
