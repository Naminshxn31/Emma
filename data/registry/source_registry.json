{
  "schema_version": 1,
  "availability_schema_version": 1,
  "updated_on": "2026-09-18",
  "purpose": "ทะเบียนกลางของแหล่งข้อมูล บอกบทบาท ระดับความน่าเชื่อถือ และขอบเขตที่อนุญาตให้ระบบนำไปใช้",
  "authority_levels": {
    "curated": "ข้อมูลที่คนดูแลแก้โดยตรง ต้องมีข้อมูลการอนุมัติก่อนใช้กับคำกล่าวเชิงพาณิชย์",
    "operational": "ข้อมูลปัจจุบันจากระบบที่เป็นเจ้าของสถานะนั้น ใช้ได้เฉพาะขอบเขตที่ระบบรับผิดชอบ",
    "reference": "เอกสารประกอบหรือคำบรรยาย ใช้ค้นและอธิบายได้ แต่ห้ามยกขึ้นแทนข้อมูลที่อนุมัติ",
    "derived": "ไฟล์ที่สร้างจากแหล่งอื่น สร้างใหม่ได้และไม่ใช่ต้นฉบับ",
    "sample": "ข้อมูลสมมติสำหรับพัฒนา ห้ามนำเสนอเป็นข้อมูลจริง",
    "private_runtime": "ข้อมูลส่วนบุคคลหรือข้อมูลที่เกิดระหว่างใช้งาน ห้าม commit และไม่ใช่ความจริงส่วนกลางของโครงการ",
    "telemetry": "ค่าที่วัดจากเครื่องหรือหุ่น ณ เวลานั้น มีอายุสั้นและใช้แทนสถานะปัจจุบันเท่านั้น"
  },
  "decision_rules": [
    {
      "id": "commercial_numbers",
      "rule": "ราคา โปรโมชั่น ขนาดห้อง และคำสัญญาเชิงพาณิชย์ใช้ได้จาก project_facts หรือ live_unit_inventory ในขอบเขตที่อนุญาตเท่านั้น",
      "fallback": "บอกว่าไม่มีข้อมูลที่ยืนยันและให้ติดต่อฝ่ายขาย"
    },
    {
      "id": "presentation_does_not_override_facts",
      "rule": "คำบรรยายสไลด์และเอกสารการตลาดช่วยค้นภาพหรืออธิบายแนวคิด แต่ห้ามใช้แก้ทับตัวเลขหรือสถานะในแหล่งข้อมูลที่อนุมัติ"
    },
    {
      "id": "live_state_wins",
      "rule": "สถานะปัจจุบันของหุ่น แบตเตอรี่ กล้อง ไมค์ ฐานล้อ และการเชื่อมต่อ ให้เชื่อ telemetry ที่อ่านได้ในขณะนั้นก่อนคู่มือหรือรายงานเก่า"
    },
    {
      "id": "robot_capability_requires_evidence",
      "rule": "คู่มือบอกขอบเขตที่อาจทำได้ ส่วนชื่อช่อง คำสั่ง และท่าที่ใช้จริงต้องอ้าง robot_interface_reference หรือผลทดสอบทางกายภาพที่บันทึกไว้"
    },
    {
      "id": "sample_never_becomes_truth",
      "rule": "การเปิดโหมดตัวอย่างต้องคงป้าย sample ในผลลัพธ์และห้ามนำข้อมูลนั้นไปเขียนกลับเป็นข้อมูลจริง"
    }
  ],
