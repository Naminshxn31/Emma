# What the robot's server sets differently from this PC's .env.
# `scripts/robot_server.py secrets` writes the robot's .env = the PC's .env
# (minus the keys in robot_server.ENV_DROP) with these lines on top.
# NO SECRETS IN THIS FILE: it is tracked.

# The project (sales) mode is the robot face's default every time (owner,
# 10 Oct: "ให้เปิดโหมดสำหรับโครงการขึ้นเป็น default ทุกครั้ง") -- EmmaJoke
# cannot answer project questions by design. The face app passes no profile.
ASSISTANT_PROFILE=condo
# condo listens "near" on a PC (AGC off + VAD_MIN_RMS 0.04). On the robot that
# floor would have cut ~21% of 9 Oct's real openings; keep the robot's far
# mode with its measured 0.02 floor (below) and let focus do the rest.
LISTEN_FAR_PROFILES=joke,translator,condo
# Lights/AC: the IR hub (192.168.0.x) is unreachable from the robot's Wi-Fi
# (192.168.1.x) -- on 9 Oct the tools ran as mock all day and Emma still
# offered them. Put `smarthome` back once the hub and robot share a network.
TOOL_GROUPS=knowledge,mydocs,units,calc,robot,body,stories
# Arm/head gestures by voice (owner 12 Oct: "ยกแขน" through Emma). `body` above
# gives the model move_body; the app's own switch ("สั่งท่าทางด้วยเสียง" on the
# operator screen) must be on too. Only verified gestures play (greet_arm,
# handshake, rest); the rest answer needs_mapping until a pose is recorded.
# The heard guard (ROBOT_BODY_REQUIRE_HEARD, default on) stays on.
ROBOT_BODY_ENABLED=true
# Answer completely, then ask ONE follow-up if the guest stays silent this
# long after her voice ends; any voice cancels it (owner 12 Oct; research
# and the reasons for 4 s in app/config.py). Tune from `follow_up` rows.
FOLLOW_UP_AFTER_S=4
# A heard question Gemini leaves unanswered (14 Oct: 146 s of nothing from
# the server): 8 s after the guest's last word with no reply, complete the
# turn again; 8 s more, rejoin on a new socket and ask it again as text.
# Normal replies start 1-2 s after the last word (slowest seen 6 s). Tune
# from `reply_stall` rows. Rollback = REPLY_STALL_S=0.
REPLY_STALL_S=8
REPLY_STALL_RECONNECT_S=8
# A reply that is only "ค่ะ" (staff talk not meant for her) is not played or
# shown -- the robot stays silent (owner 15 Oct). Rows: bare_ack_dropped.
SILENCE_BARE_ACK=true
# The matching picture with an answer, without the presentation (owner,
# 11 Oct: "ให้ดูภาพตัวอย่าง" -> "ทุกเรื่องที่มีภาพตรง"). `deploy` ships the 48
# manifest-pinned slide pictures (33 MB) only while this is on.
ANSWER_IMAGES=true
# Stories drawn with her voice on the face (present_story, owner 13 Oct:
# "อนุมัติชุดภาพและเรื่อง ... ลงหุ่นแล้ววัดบนเครื่องจริง"). Needs `stories` in
# TOOL_GROUPS above and an approved catalog (approve_stories.py); `deploy`
# ships the catalog's pinned pictures only while this is on.
STORIES_ENABLED=true

# Off the LAN: only the face app on the robot itself (and a PC through
# `robot_server.py forward`, i.e. adb) can reach the server and its keys.
HOST=127.0.0.1
PORT=8001
SSL_CERTFILE=certs/lan-cert.pem
SSL_KEYFILE=certs/lan-key.pem

# The reloader watches files and drops every WebSocket on a restart.
DEV_RELOAD=false
# Playwright/Chromium windows do not exist on Android (Canva, web stage).
WEB_STAGE=false
CANVA_OPEN_AT_START=false
# The PC's index (embeddings.npz) is local MiniLM built with torch. The robot
# has no torch: it runs the ONNX export of the same model (app/embed_onnx.py,
# measured equal to the PC's vectors -- same index, no rebuild), fetched on
# `deploy` (FETCH_ON_ROBOT). Files missing or unverifiable = lexical (BM25)
# with one log line, as before.
EMBED_PROVIDER=local

# The board is inside the robot: no adb forward on this side.
ROBOT_CHASSIS_URL=http://192.168.11.1:1448
# The arm belongs to the face app (CH340 via the Aobo SDK); the server's
# adb-printf path has no adb here.
ROBOT_ARM_ADB=
ROBOT_ARM_ADB_SERIAL=

# Greeting with the handshake (group 6) for EVERYONE the camera greets (owner
# 10 Oct: "เอาท่าจับมือท่า 6 ทักทายทุกคนที่หุ่นเห็นหน้า") -- strangers and
# groups too, not only named people (9 Oct's rule, FACE_HANDSHAKE_NAMED_ONLY
# below, now off). Still no greeting at all mid-conversation (owner 30 Sep:
# ประโยคทักทายไม่ให้พูดแทรก), and the app still refuses gestures while
# walking / latched / busy / over its per-minute cap.
ROBOT_GREETING_GESTURE_ENABLED=true
ROBOT_ARM_MOTION_ENABLED=true
# Base motion from the server stays off (bring-up 9 Oct); walks run from the
# face panel through the launcher, which does not use this switch.
ROBOT_CHASSIS_MOTION_ENABLED=false

# "Probably someone we know" (owner 9 Oct: far face, not sure → check first):
# hold the stranger greeting, never say a name while unsure, ask the
# face page for a sharp crop (40 px faces named 25 -> 30 of 35 in the eval).
# 8 s -> 3 s on 13 Oct (owner: "ทักช้า"): greetings came 15-38 s after the
# camera opened the call, the 8 s hold expiring on a close face that the
# detector finds for one frame at a time. A known face is still named when
# sure; past 3 s an unsure one is greeted without a name.
# 3 s -> 0 later on 13 Oct (owner: "ทักช้า ... กล้องตัวหุ่นไม่ค่อยดี"): on this
# camera every close arrival scores in the "probably known" band (29 of 29
# on 12-13 Oct, faces 209-577 px) and 28 of them were lost before the hold
# ended -- the hold delayed the greeting of nearly everyone and named nobody.
# Off = greet as soon as 2 frames agree; a known face is still named when sure.
FACE_PROBABLE_WAIT_S=0
# The PC waits 3 s for a sharp frame before calling an arrival a stranger;
# here the face is gone by then, so the greeting never came (ears opened
# "greeted: False" 9-10 s after the dial on most 12 Oct calls).
FACE_TRACK_WAIT_S=0
# A summoned call is deaf until its greeting is heard; if none comes, this
# long (code default 10 s) -- a guest who spoke first was ignored meanwhile.
SUMMONED_HOLD_MAX_S=4
FACE_ZOOM_ENABLED=true
FACE_HANDSHAKE_NAMED_ONLY=false
# Turning toward a far face: off -- the robot is docked most of the time, routes
# own the base (nudge refuses routes_own_the_base), and a yaw-only MoveTo has
# never been seen to rotate in place on this board (needs a bench test first).
FACE_TURN_TO_CHECK=false

# The นำทาง slot on the face's hold menu (owner 9 Oct: "ยังไม่เห็นฟังก์ชั่น
# นำทางเลย"). `open` is the owner's choice (9 Oct, "ไม่ใช้ PIN"): anyone at
# the face can start a walk with the 1 s hold -- `pin` + ROBOT_NAV_PIN in the
# PC's .env is the safer mode for a room with customers.
# The robot app's own switch (operator screen: hold top-left 3 s ->
# "ฟังก์ชันนำทาง") must be on too. Voice starts stay off (ROBOT_NAV_VOICE).
ROBOT_NAV_ROUTES_ENABLED=true
ROBOT_NAV_PANEL=open

# Listening focus (docs/listening-focus-2026-10-09.md), first supervised
# trial 9 Oct: answer only the person in front of the camera. Owner: the robot
# answered people chatting nearby. Rollback = FOCUS_ENABLED=false.
FOCUS_ENABLED=true
FOCUS_REQUIRE_FACE=true
FOCUS_FACE_MIN_PX=60
# Facing rule off (owner 9 Oct: "การหันหน้าเข้ากล้องเอาออกดีกว่า"); size still decides.
FOCUS_YAW_MAX_DEG=0
FOCUS_HOLD_S=2.0
# 13 Oct (owner: "คุยด้วยไม่ค่อยตอบ ... ทักช้า"): 12-13 Oct logs had 1,065
# segments denied "no face in front" to 86 opened. A guest at the chest
# screen is under the head camera, or found for one frame and lost. After a
# face-verified segment, 20 s without a face is still the conversation; a
# voice at >= 0.06 (opened p50 0.057, room chatter 0.02-0.04) is at the robot.
# Simulated on those logs: ~120 more segments heard, the chatter still out.
FOCUS_CONVERSE_HOLD_S=20
FOCUS_NEAR_RMS=0.06
# The hold above starts only from a face-verified segment -- and on 12 Oct
# all 983 denials had no face at all, so it rarely started. Turn-taking
# instead: a voice that starts within 10 s after her voice ended (greeting
# or answer) is the guest answering her. Chatter lands only inside that
# window; the 0.02 floor below still applies. Tune from "reply to her" rows.
FOCUS_REPLY_WINDOW_S=10
# Labels to Gemini: unmeasured (may hold a reply; read-aloud unknown).
FOCUS_SPEAKER_LABELS=false
# Mouth movement at 10 fps first: robot CPU is unmeasured (watch "asd:" lines).
ASD_ENABLED=true
ASD_FPS=10
# Voice prints: threshold measured on PC audio, not on the far-field array.
VOICEPRINT_ENABLED=false
# Reception-robot engagement, phase 1 (10 Oct; review's recommendation).
# "Emma" said during a call opens 10 s in which an out-of-view caller is heard
# (Look and Talk's "say the name outside the zone"); the mascot looks toward
# whoever speaks (Furhat). Invite / goodbye / full engagement wait for a day
# of focus_wake and focus_gap rows (scripts/analyze_log.py).
FOCUS_WAKE=true
FOCUS_WAKE_THRESHOLD=0.10
FOCUS_WAKE_WINDOW_S=10
FOCUS_ATTENTION=true
FOCUS_ENGAGE_MODE=semi
FOCUS_INVITE=false
FOCUS_INVITE_DENIED_N=0
FOCUS_GOODBYE=false
# Mic-array direction: OFF -- the concurrency test failed (10 Oct, measured):
# the Bothlent array gives Android ONE capture stream. App first (8 ch) = the
# WebView's call mic reads exact zeros the whole call (Emma deaf, 37 reports);
# page first (2 ch) = the app gets 2 of 8 channels, the rest zero. Direction
# and ARRAY_AUDIO need the app to be the array's only owner first.
DOA_ENABLED=false
# The robot's call had no loudness floor at all (joke is in LISTEN_FAR_PROFILES).
# 0.02 cuts ~1.5% of today's real openings; 0.04 would cut ~21% (9 Oct log).
VAD_MIN_RMS_FAR=0.02

# Debug audio dumps fill the robot's disk with customer voices.
WAKE_DEBUG=false
CALL_DEBUG=false
