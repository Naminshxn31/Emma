# What the robot's server sets differently from this PC's .env.
# `scripts/robot_server.py secrets` writes the robot's .env = the PC's .env
# (minus the keys in robot_server.ENV_DROP) with these lines on top.
# NO SECRETS IN THIS FILE: it is tracked.

# The project (sales) mode is the robot face's default every time (owner,
# 10 Oct: "ให้เปิดโหมดสำหรับโครงการขึ้นเป็น default ทุกครั้ง") -- EmmaJoke
# cannot answer project questions by design. The face app passes no profile.
ASSISTANT_PROFILE=condo
# condo listens "near" on a PC (AGC off + VAD_MIN_RMS 0.04). On the robot that
# floor would have cut ~21% of 9 Oct's real openings; keep the robot's far
# mode with its measured 0.02 floor (below) and let focus do the rest.
# event and ceremony are condo's prompt plus a block, on the same robot and mic: added 10 Nov
# (they had been left out when those apps came -- the Event app's calls opened with the PC's
# 0.04 floor, AGC off and hold-speech on, the floor that cut ~21% of real openings; on 9 Nov
# the robot's real openings were 0.021-0.043). An external mic is to be measured on its own.
LISTEN_FAR_PROFILES=joke,translator,condo,event,ceremony
# The staff pages' "เน็ต" lamp (owner 10 Nov, ahead of a crowded event): the robot probes Google's
# Live host every NET_PROBE_S (DNS + TCP + TLS, no API call) and both control pages show ok / slow /
# flaky / down. Shown only -- the offline voice and the dial back-off still need OFFLINE_FALLBACK.
NET_STATUS=true
# Lights/AC: the IR hub (192.168.0.x) is unreachable from the robot's Wi-Fi
# (192.168.1.x) -- on 9 Oct the tools ran as mock all day and Emma still
# offered them. Put `smarthome` back once the hub and robot share a network.
TOOL_GROUPS=knowledge,mydocs,units,calc,robot,body,stories,screens
# Arm/head gestures by voice (owner 12 Oct: "ยกแขน" through Emma). `body` above
# gives the model move_body; the app's own switch ("สั่งท่าทางด้วยเสียง" on the
# operator screen) must be on too. Only verified gestures play (greet_arm,
# handshake, rest); the rest answer needs_mapping until a pose is recorded.
# The heard guard (ROBOT_BODY_REQUIRE_HEARD, default on) stays on.
ROBOT_BODY_ENABLED=true
# Arms while she talks, the robot's right then left in turn (owner 15 Oct:
# "ให้ขยับซ้ายขวาสลับกันตอนคุย"). Plays only the poses recorded in the app's
# studio for raise_right_arm / raise_left_arm, and only while the app's
# "สั่งท่าทางด้วยเสียง" switch is on. Rows: speech_gesture. Rollback = false.
SPEECH_GESTURES=true
# The head turns toward the person she talks with, and looks down when a voice
# at the robot comes with no face in view (owner 31 Oct; app/head_follow.py).
# Needs the APK with HeadLook (.tmp/apk/emma-robot-headlook-20261031.apk) and
# the same "สั่งท่าทางด้วยเสียง" switch. OFF until the first bench run with
# somebody watching (docs/robot-servo-limits-2026-10-31.md): ch8 burned once.
# Range knobs (percent of the app's +-200 us): HEAD_PAN_MAX=60,
# HEAD_TILT_DOWN_MAX=18, HEAD_TILT_UP_MAX=12, HEAD_SEARCH_TILT=18 (defaults).
# 4 Nov dock ladder: the head STOPS at ~22-23 % down and ~16 % up -- never set
# the tilt knobs past that (the servo pushes on a stopped head; ch8 smoked 12 Sep).
# The first call after turning it on SWEEPS the head (centre/left/right/down/
# centre, ~10 s) and measures direction + degrees from the head camera
# (HEAD_CALIBRATE, default on) -> data/robot/head_calibration.json on the
# robot; delete that file to measure again. Face something with detail.
HEAD_FOLLOW=true
# Where the head is straight on THIS robot (owner 25 Nov ~04:15, in the app's pose studio: ch7 straight at 1480; the
# app's centre is 1500, 1% = 2 us, + = the robot's left -> -10): every look the server asks is from there, and a
# ceremony call re-sends its centre every 4 s (the app takes the head to its own 1500 after 10 s with no look).
HEAD_PAN_TRIM_PCT=-10
# The head locks on the FIRST person it turns to and follows only them while
# they stand there talking; once they are gone (6 s unseen) it comes back to
# centre, then takes the next person (owner 10 Nov: "เวลาหุ่นเห็นหน้าใครคนแรก
# อยากให้กล้องแทร็กตามคนนั้น ... พอเขาไปหุ่นก็กลับมาตรงเหมือนเดิม ไม่ต้องหันไปมา
# ตลอดเวลา" -- that day's log: the head jumped between the faces in view). The
# mascot's eyes still visit (FOCUS_GAZE_VISIT_S). Rows: head_lock. false = the
# head follows the eyes' cue again.
HEAD_FOLLOW_FIRST=true
# The head stays STILL in a ceremony call (owner 24 Nov: "ไม่ต้องให้หุ่นหันหัวไปมาตอนพูดแล้วให้ขยับมือเหมือน
# ที่ทำตอนแรกพอ"): one look to centre at the call's start, then no head move from the server at all (no face
# lock / lidar or voice turn / look down / sweep / walk scan); only her talking arms (SPEECH_GESTURES) move.
# Sales and Event calls are not touched. false = as before.
CEREMONY_HEAD_STILL=true
# ...and that first person is somebody who SPOKE or stands in front, never a face
# walking across the lens (owner 12 Nov: "อยากให้หันตามคนที่พูดคนแรกหรืออยู่ด้านหน้า").
# 12 Nov's log with "first": 37 locks, all "the biggest face in view", 35 gone within
# 10 s. "speaker": the face her ears opened for (attention's mouth/label/main), the
# face found where a loud voice aimed the head (the look down / the lidar's turn),
# else one in the picture HEAD_FRONT_STAND_S, the most central first. head_lock rows
# say which ("speaker", "voice_look", "front").
HEAD_LOCK_BY=speaker
HEAD_FRONT_STAND_S=2.5
# The look down for a loud voice with no face only when the lidar has somebody in the head's reach
# (owner 12 Nov "ทำเลย"; 15:42-16:20 with the GCK mic as her ears: 39 looks down and back in 37 min,
# a face in 45 of 5,971 frames, the nearest person mostly 60-100 deg off ahead). Rows: head_look
# why=search_skipped (where the nearest one was). No fresh lidar = the search as before.
HEAD_SEARCH_NEEDS_LIDAR=true
# On a walk the head nods once (18 %, never a pan) while the base stands, so
# the walk pictures see desk tops (owner 4 Nov: "ให้มันสแกนไปด้วยว่ารอบมีอะไร" then
# "อย่าหันหัวไวเกินและถี่เกิน"); the base turns for the sides. Needs the APK with
# HeadLook's walk box (4 Nov); an older one refuses and the walk looks ahead
# as before. Off = ahead only.
HEAD_WALK_SCAN=true
# Quiet on a walk no guest is on (PC routes, board_walk over adb, a joystick;
# not the event host's): her replies are not played or shown, a stop still is
# (owner 4 Nov: "พูดเองด้วย" -- she answered the office's talk through the survey).
WALK_QUIET=true
# The head camera as measured 4 Nov: 19 deg wide (base spot turns vs board
# odometry), picture mirrored. For the walk pictures / map check only.
ROBOT_CAMERA_HFOV_MEASURED=19
ROBOT_CAMERA_MIRRORED=true
# The lidar's people for the head (app/lidar_people.py): reads the board's
# scan twice a second ONLY while HEAD_FOLLOW is on (inert until then). A face
# + the one person the lidar sees are paired to measure the camera in true
# degrees; once that check holds, a voice at the robot with no face in view
# turns the head toward the nearest person on the lidar (not just down).
LIDAR_PEOPLE=true
# The head camera says whether what the lidar found is a person (app/person_vision.py, one core, once a
# second, only while staff have the walk on; owner 5 Nov: "ให้กล้องช่วยตรวจดูไม่ได้หรอ"). Inert until
# FACE_APPROACH and FACE_APPROACH_ANYONE are on.
PERSON_VISION=true
# Walking up to people (app/face_approach.py, docs/emma-face-approach.md 7, 9, 11). Owner 9 Nov: "ยังไม่เห็น
# หุ่นเวลาเห็นคนแล้วเดินไปเลย" -> "ตั้งให้ลองบนหุ่น": the bench's first stage, a DRY RUN -- she works out who
# and where, turns her head to look (PERSON_VISION) and writes `would_walk`; the wheels never turn and she
# says nothing. Only once staff have marked the area with the robot itself and pressed the switch on the
# event page (it stays off through a restart). The real walk is DRY_RUN=false + EVENT_WALK_ENABLED=true,
# with the owner beside her and somebody on the E-stop.
FACE_APPROACH=true
FACE_APPROACH_ANYONE=true
FACE_APPROACH_DRY_RUN=true
# 9 Nov the floor-2 dry run lowered FACE_APPROACH_MIN_QUALITY to 45 (Q 52 at the dock); back to its 60
# on 10 Nov when EVENT_WALK_ENABLED went on for the debut's walk ahead -- a low walk-up gate never rides
# with walking on (tests/test_robot_server.py). On floor 2 the dry run now stops at the gate.
# A tap on Muted outlives the page (owner, 5 Nov, twice: "ปิดไมค์ แต่เหมือนรีแล้วก็กลับมาพูด",
# "ปิดไมค์ ... อยู่หุ่นก็สามารถได้ยิน"): the hold lived in the WebView's sessionStorage, and
# Android rebooted 9 times on 5 Nov. Kept in data/robot/mic_hold.json until a tap on the mic or
# 06:00 next morning (app/wake.py). The camera still opens a line through it: MUTE_CAMERA_GREETS.
MIC_HOLD_PERSIST=true
# Head-camera pictures + pose + lidar every second of every walk, kept 7 days
# on the robot (owner 31 Oct: "ลองให้เดินแล้วดูภาพประกอบด้วยจะได้ประเมินถูก").
# Pull + contact sheet on the PC: python scripts/walk_frames.py pull --last
WALK_FRAMES=true
# 4 Nov, TEMPORARY: 4 pictures a second while the room survey measures the
# head camera's real width from the base's spot turns (0.5 rad/s = ~7 deg a
# picture; at 1 a second a turn is ~29 deg between pictures, past this narrow
# lens). Back to 1.0 once measured.
WALK_FRAMES_EVERY_S=0.25
# Answer completely, then ask ONE follow-up if the guest stays silent this
# long after her voice ends; any voice cancels it (owner 12 Oct; research
# and the reasons for 4 s in app/config.py). Tune from `follow_up` rows.
FOLLOW_UP_AFTER_S=4
# A heard question Gemini leaves unanswered (14 Oct: 146 s of nothing from
# the server): 8 s after the guest's last word with no reply, complete the
# turn again; 8 s more, rejoin on a new socket and ask it again as text.
# Normal replies start 1-2 s after the last word (slowest seen 6 s). Tune
# from `reply_stall` rows. Rollback = REPLY_STALL_S=0.
REPLY_STALL_S=8
REPLY_STALL_RECONNECT_S=8
# Each turn re-sends the conversation; this key's free tier allows 65,000
# tokens per MINUTE for Gemini 3.8 Live (how that meter counts a Live turn is
# not measured: the robot's per-turn prompts summed far above it on 20 Oct
# uncut), and a 23-minute call reached 85,000 a turn with both drops at the
# peaks. Compress past 32,000, keep 20,000: the system instruction + tools
# alone are ~12,300 (20 Oct), so ~7,700 of conversation (~12 replies) stay.
# A stall that survives the rejoin goes to GEMINI_MODEL_FALLBACK (its own
# quota) -- app/providers/gemini.py stage 3.
LIVE_CONTEXT_COMPRESS_AT=32000
LIVE_CONTEXT_KEEP=20000
# A reply that is only "ค่ะ" (staff talk not meant for her) is not played or
# shown -- the robot stays silent (owner 15 Oct). Rows: bare_ack_dropped.
SILENCE_BARE_ACK=true
# Her reply to a quiet sound nobody could make out is not played (owner 29 Oct:
# far or unclear = noise, skip it; near and loud but not caught = ask again).
# Quieter than 0.06 at its opening (FOCUS_NEAR_RMS: a voice at the robot), at
# most 4 letters of caption (not "Emma", not "what?"), no tool called = dropped.
# Replay of the robot logs 9-27 Oct: 14 of 958 replies -- "โอเค"/"ครับ"/"อื้อ"/
# "de" answered with an offer or "ได้ยินไม่ชัด"; every reply that called a tool or
# came from a voice at >= 0.06 kept. Rows: noise_reply_dropped. 0 = off.
NOISE_REPLY_NEAR_RMS=0.06
# Every tool result says which language the talk is in, kept from what the
# guest said (app/talk_lang.py): 19 Oct an English talk went German on one
# accented line and Thai on a "yeah" heard as "ใช่".
TALK_LANGUAGE_NOTE=true
# She starts in English until the guest speaks, and greets somebody she
# recognises in English (owner 3 Nov: "ภาษาให้ตั้ง eng เป็น default"). A
# default, not a pin: the guest's first sentence still sets the language.
TALK_DEFAULT_LANGUAGE=en
# The matching picture with an answer, without the presentation (owner,
# 11 Oct: "ให้ดูภาพตัวอย่าง" -> "ทุกเรื่องที่มีภาพตรง"). `deploy` ships the 48
# manifest-pinned slide pictures (33 MB) only while this is on.
ANSWER_IMAGES=true
# Stories drawn with her voice on the face (present_story, owner 13 Oct:
# "อนุมัติชุดภาพและเรื่อง ... ลงหุ่นแล้ววัดบนเครื่องจริง"). Needs `stories` in
# TOOL_GROUPS above and an approved catalog (approve_stories.py); `deploy`
# ships the catalog's pinned pictures only while this is on.
STORIES_ENABLED=true

# Off the LAN: only the face app on the robot itself (and a PC through
# `robot_server.py forward`, i.e. adb) can reach the server and its keys.
HOST=127.0.0.1
PORT=8001
SSL_CERTFILE=certs/lan-cert.pem
SSL_KEYFILE=certs/lan-key.pem
# The room screen's copy of the face (owner 28 Oct, "หุ่นเปิดช่องดูอย่างเดียว";
# app/face_mirror.py): a SEPARATE listener on the LAN, view only -- the page
# at /mirror and its read-only socket, nothing of the server above. Needs
# MIRROR_TOKEN in the PC's .env (pushed by `secrets`; never in this file).
# Open on the room screen: http://<robot-ip>:8002/mirror?token=...
MIRROR_PORT=8002
# The event host's staff page (owner 30 Oct: "ให้ทีมงานกดเปลี่ยนซีน", 25-26 Nov
# on floor 1; app/event_host.py): a THIRD listener on the LAN for the staff
# phone, used by the "Emma Event" app's calls. Needs EVENT_CONTROL_KEY in the
# PC's .env (pushed by `secrets`; never in this file) -- without it the page
# stays off. Open on the phone: http://<robot-ip>:8003/event-control?key=...
# The "Emma Ceremony" app's page is on the same listener and key (owner 9 Nov:
# "อันนี้ทำแยกกับอันเดิมนะ ไม่งั้นจะปนกัน"; app/ceremony.py, its script and running order in
# CEREMONY_FILE, default data/ceremony/floor1_ceremony.json): .../ceremony-control?key=...
EVENT_CONTROL_PORT=8003
# The scan booth's guests (app/guests.py, app/guest_sync_server.py, docs/emma-scan-booth-rehearsal.md;
# owner 23 Nov: "ให้สแกนแล้วส่งข้อมูลมาที่หุ่นเลย ... จะให้หุ่นจำได้เวลาวันอื่นที่ลูกค้ามาดูโครงการ"):
# their vectors beside the staff gallery, never shipped by deploy, deleted on the date on the
# booth's notice. A FOURTH listener on the LAN, HTTPS with the robot's lan cert, its own key:
# GUEST_SYNC_KEY in the PC's .env (pushed by `secrets`; never in this file) -- without it the
# listener stays off and says so. The booth: GUEST_SYNC_URL=https://<robot-ip>:8004.
FACE_GUESTS_FILE=data/faces/guests.npz
GUEST_SYNC_PORT=8004
# Walking from that page (scripts/board_walk.py on the robot). Off until the
# owner says the robot is on its spot (29 Oct: "อย่าเดินนะ ตอนนี้หุ่นไม่ได้อยู่
# ที่ตำแหน่ง"): the scenes still run, Emma acting them where she stands.
# 10 Nov 2026: on at 12:35 (owner: "เปิดสวิตช์การเดิน"), off again at 13:45 (owner: "ค่อยเดิน
# ปรับท่าโบกมือทักทายก่อน" -- the pose first, the walk after; the debut then waves where she stands).
# On again at 19:50 (owner, after the standing debut with the recorded line: "ขอเดินด้วย") -- the
# debut's metre ahead off the floor-2 dock, the owner beside her. Off again at 22:50 (owner: "ห้ามเดินนะ"
# -- the debut walk was never pressed after the call-up fix; the scenes play where she stands). On again
# 11 Nov 09:2x (owner pressed the debut at 09:14 and asked why she did not walk -> "เปิดเลย").
EVENT_WALK_ENABLED=true
# The walk's battery floor (app/event_walk.py; code default 20, a guess before any event-day
# measurement): 10 since 11 Nov (owner, the board charging from 0 % after the night -- the debut was
# refused at 0 and 15 %: "เราปรับแบตเหลือ 10 ได้ไหมถึงจะเดินไม่ได้"). A walk to the dock is never refused for it.
EVENT_WALK_MIN_BATTERY=10
# The debut's English pageant line plays from a file in the voice the owner picked by ear (10 Nov:
# a blind test of Despina beside ElevenLabs voices -> "Jessica v3 รอบแรก (C) ชอบเสียงนี้ ... เราใช้
# โชว์แค่วันงาน"): the scene's `recorded` (data/events/clips/, gitignored, shipped by deploy), its
# sha256 pinned in the event file. Every other word is still the live model's (Despina). No file /
# not the pinned take / no call = she says the line herself, as before. app/event_host.py
EVENT_RECORDED_LINES=true
# Card 1's whole opening in one press (owner 23 Nov 2026: "การ์ดแรก ให้หุ่นเปิดตัวตามที่ซ้อมไว้ ... ไปหน้าเคาน์เตอร์
# แล้วจับมือมิกิ แล้วหันหลัง ไปจับมือกับแขกสักสามจุด ... แล้วก็กลับมาหน้าเคาน์เตอร์"): the debut, then the counter's
# handshake, guest_1..3's, back to the counter, the head still throughout (app/event_tour.py, the debut's `tour`).
# A guest spot not recorded = no guest round (she stays at the counter). Never run on the robot yet.
# false = card 1 is the debut alone, as before.
EVENT_TOUR=true
# ...and the robot opens it ON the room screen itself (owner 28 Oct: "ไม่เอา
# เปิดเว็บทิ้งไว้ ... หุ่นไปอยู่ใกล้จอ หรือสั่งให้เปิดจอก็ให้หุ่นเชื่อมจอเลย";
# app/room_screens.py): `screens` in TOOL_GROUPS above = "เปิดจอ"/"ปิดจอ", and
# a screen with a `near` position opens/closes as the robot comes and goes.
# The screens and each PC's key are in room-screens.json beside the .env
# (pushed by `secrets` from this PC's data/room-screens.json -- never here).
# Each room PC runs its agent with ROOM_AGENT_ALLOW=emma_screen_open,emma_screen_close.
# Rollback = false (the tool disappears, nothing reaches any PC).
ROOM_SCREENS_ENABLED=true
ROOM_SCREENS_FILE=room-screens.json
# Owner 16 Nov (floor 1, lobby screen laptop): "อยากทดสอบเสียงจอใหญ่" -- the room screen plays her
# voice too (the mirror URL gets sound=1). A TEST: the robot's own speaker still speaks, and its mic can
# hear the screen's later copy (no echo guard for that is built). false = the screen is silent again.
ROOM_SCREEN_SOUND=true
# The lobby's amplifier goes to standby when nothing plays (owner 16 Nov: "พอไม่มีเสียงก็จะพักเสียงไปเองเลย
# ... กลัววันงานจะมีปัญหา"): the screen page holds one quiet tone, <hz>,<dB>. A first guess, not yet heard on
# the room's own set -- low so it passes any cable or Bluetooth link. Empty = no tone.
ROOM_SCREEN_KEEP_TONE=25,-36
# The host wears the wireless mic and her voice comes out of the room's speakers (owner 17 Nov): for
# this long after her voice ends the mic goes up as silence, while a screen is open with its sound.
# 0.8 is a first guess (the robot face's own guard is 0.35) -- set it from the `room_echo_guard`
# rows of a call in the room (`after` = how loud the tail itself still was). 0 = off.
ROOM_SCREEN_ECHO_TAIL_S=0.8
# Owner 24 Nov, on the doubled voice in the hall: "อาจจะเปลี่ยนให้ตอนที่คุยกะมิกิ ให้เสียงออกหุ่นแทนแล้ว จะได้
# เหมือนคุยกับหุ่นจริงๆ"; asked which parts: "ทั้งพิธีออกหุ่น" -- every recorded line and every ตอบสด answer plays from
# the ROBOT speaker only. The hall screen keeps pictures/slides/Thai subtitles and the debut music (sound=1);
# her voice there is at the silent gain and the echo tail above does not apply to it. Rollback = false +
# robot_server.py secrets + restart (docs/emma-ceremony.md). The robot's Android media volume must not be 0.
CEREMONY_VOICE_ON_ROBOT=true
# Owner 24 Nov 22:28, after a full card-1 run: the catwalk's music on the hall's notebook from the walk-out until the robot has
# walked everything (app/catwalk_music.py; the files are data/events/clips/catwalk_*). Rollback = false + secrets + restart.
CATWALK_MUSIC=true
# 24 Nov 23:30 (owner: test everything about what is said and asked): the robot's log of the day shows the Live socket closed by
# Google after every 2 quiet minutes and rejoined in 1-4 s; what Khun Miki said in those seconds was lost. Rollback = false.
RECONNECT_KEEPS_MIC=true
# 24 Nov night, the long-talk audio test: "Emma," after a pause was clipped off the ceremony call's segment (300 ms pre-roll).
# The ceremony call alone (config.ceremony_prefix_padding_ms). Rollback = 0.
CEREMONY_PREFIX_PADDING_MS=1000
# Owner 24 Nov: "อยากจะให้ตอนพูด จอหุ่น กับจอคอมนี้ขึ้นพรีเซ้นต์โมชั่นเหมือนกันเลย" -- the Emma Ceremony app's chest screen plays the
# hall's film (silent, same Thai subtitles) in a frame over Emma (app/face_film.py). Needs MIRROR_TOKEN. Robot fps is UNMEASURED:
# if it stutters at the rehearsal try CEREMONY_FACE_FILM_SCALE=0.5, or rollback = false + robot_server.py secrets + restart.
# OFF 11:05 ("ทำเรื่องพูดก่อน") -> ON 24 Nov ~13:50 (owner, the rehearsal's chest screen played an old story: "หน้าจอ ทำไมมันขึ้นของเดิม
# แล้วของใหม่ที่เราทำไม่เอามาหรอ งั้นตอนนี้เอาใหม่เลย"). Robot fps still unmeasured -- watch it at the rehearsal.
CEREMONY_FACE_FILM=true
# Owner 24 Nov, the day before the event: "เราจะทำเป็นการ์ดสอง หลังจากจับมือกับแขก ... แล้วหุ่นจะคุยกับคุณมิกิ ช่วงนั้นเราอาจจะ
# เปิดสด ... แต่ให้ฟังเสียงคุณมิกิเท่านั้น"; asked which form: "ทั้งพิธีคุยสด ไม่ใช้บทกด". On: card 2 is in the ceremony's order;
# pressing it makes the SERVER follow the host -- his scripted line plays the next cue (app/ceremony_follow.py), anything
# else she answers live when he says "เอ็มม่า". Manual presses stay as the fallback. Rollback = false + robot_server.py
# secrets + restart: the ceremony is then exactly the pressed one (docs/emma-ceremony.md).
CEREMONY_FOLLOW_HOST=true

# "เพราะเขาจะพูดสด ดังนั้นก็เหมือนตอนที่เราทำตอนแรก ให้หุ่นสามารถตอบได้แม้จะไม่ตรงกับบทมาก" (owner 24 Nov 11:00): in follow
# mode she answers the host live without her name while the live window is open; a matched cue plays alone (no live reply).
CEREMONY_FOLLOW_ANSWER_ALL=true
# "เอาที่พูดสดเหมือนที่เราทำแอพเก่ามาใช้ได้นะ" (owner 24 Nov): her live answer has the approved script in context (the 6-7 Nov
# EVENT_SCRIPT_PROMPT mechanism), minus the cues the server plays itself.
# Free talk too (owner 24 Nov ~13:40, rehearsal: "what can you do?" got the robot's body, not the script -- "ให้มันตรงกับโครงการ
# หรือบทที่เรามีด้วยสิ" / "เราก็สามารถเอาของสคริปมาเป็นคำถามได้หนิ"): his English questions of the script + her lines (continuations
# joined, staff-tick lines and the auto jokes left out) are in her context; she answers a short form of the matching line.
CEREMONY_FOLLOW_SCRIPT_PROMPT=true
# "แล้วพอพูดตามบทแล้ว มันก็ไม่พูดหรือตอบ อยากให้มันตอบสดเลย ไม่ต้องมากดตามบท การกดตามจะเป็นวิธีสุดท้ายหลังจากการตอบสดทำได้ดี"
# (owner 24 Nov ~11:40): false = live first -- the matcher never presses a cue and never holds/drops her reply; a scripted line
# only puts that cue's slide on the hall screen and moves the pointer on. The staff's own press stays as the fallback.
# -> true again 24 Nov ~13:50 (owner: "ถ้าคำถามที่เขาคล้ายกับเรา ก็ให้ตอบตามสคริปที่เราทำ แล้วก็โชว์ไปเลย ... อะไรที่ไม่มีในบท ก็ให้หุ่นตอบ
# แบบสดไปได้ แต่ไม่ต้องโชว์อะไร แล้วก็พยายามให้เขามาตามบทของเรา"): his question near a script question (host_en + the questions
# alone, ask_en in floor1_ceremony.host.json) = the server plays that cue (its approved words, its slide, its approved Thai
# subtitle); anything else = her live answer, nothing shown, and she invites him back to the next topic.
CEREMONY_FOLLOW_CUES=true
# "ปรับสคริปให้มีบทสั้นด้วย แล้วเวลามิกิพูดบางทีอาจจะพูดยาวแล้วค่อยมาถามเกี่ยวกับบทด้วย" (owner 24 Nov ~12:15): live first only, ceremony
# call only -- the local VAD waits 1500 ms of silence (not VAD_SILENCE_MS) before it closes the host's turn, so pauses up to ~1.5 s
# inside a long speech do not start her answer (measured offline, real Silero). Cost: her answer starts later after his real question.
CEREMONY_LIVE_END_SILENCE_MS=1500
# "ส่วนมุก ... ให้หุ่นเล่นไปเองเลย ต่อจากบทก่อนหน้า" (owner 24 Nov): live first only -- the two chain jokes (scene 4 pool, scene 6
# superfan) are pressed by the server once the cue before them was taken, her live answer is over and the host is quiet (never
# over him: after 20 s staff are told). The approved words, the staff press path. false = staff press the jokes.
CEREMONY_JOKES_AUTO=true
# "งั้นเราอย่าไปโฟกัสกับสคริปเยอะไหม เพราะสุดท้ายก็คุยด้นสด อาจจะต้องปล่อยเขาพูดกับหุ่นเหมือนตอนที่เคยทำ แต่เราแค่ปรับโมชั่นให้มันดีขึ้น
# โชว์อะไรมากขึ้น ... แค่ตอนที่โชว์โมชั่นจบก็ขึ้นหน้าโลโก้ แล้วรอฟังที่คุยกะมิกิ" (owner 24 Nov ~12:40): FREE TALK -- she answers freely and briefly,
# no nudge; the jokes play after her answer on their topic (CEREMONY_JOKES_AUTO); the script is in her prompt again since ~13:40
# (CEREMONY_FOLLOW_SCRIPT_PROMPT above); the hall shows cue slide > story > topic slide per exchange and returns to the logo CEREMONY_LOGO_AFTER_S s after her answer ends.
# false 24 Nov ~13:50: free talk is a live-first mode (CEREMONY_FOLLOW_CUES=false) -- the script plays again (above).
CEREMONY_FREE_TALK=false
# Only the script's own slides in the ceremony call: no motion story (present_story not offered to the ceremony profile),
# no topic slide from the host's words (owner 24 Nov ~13:50 "ส่วนโหมดเก่าก็เอาออกไปก่อน อันนั้นเอาไว้ใช้หลังคุยกับคุณมิกิเสร็จ").
# The Event app after the ceremony keeps its stories. Rollback = false + secrets + restart.
CEREMONY_SCRIPT_SHOW_ONLY=true
# "ต่อให้มิกิจะพูดนานแค่ไหน แต่ถ้าบอกชื่อ emma หรือออกเสียงเรียก พร้อมคำถาม ถึงหุ่นจะตอบ" (owner 24 Nov ~15:38): off the script she
# answers only when his words name her; a question of the script plays its line without the name. Rollback = false.
CEREMONY_ANSWER_NAMED=true
# "ให้ทั้งหมดที่หุ่นจะตอบก็ต่อเมื่อมีคำว่า emma" (owner 24 Nov ~17:40): a script line plays, and she answers, only when Khun Miki CALLS her;
# after her name he may go on talking (nothing is decided until he stops), and words that only MEAN a line play it too
# (host.json `means`). A short answer to a question she just asked him needs no name. Rollback = false + secrets + restart.
CEREMONY_NAME_FIRST=true
# A motion for what the script does not answer (owner 24 Nov ~18:10): the approved stories in data/ceremony/offscript_stories.json are told
# when Khun Miki calls her and asks one of them. Rollback = false + secrets + restart.
CEREMONY_OFFSCRIPT_STORIES=true
# The same stories as recorded lines of the ceremony's own (owner 24 Nov ~19:20: "ก็ให้มันทำเป็นบททั้งหมดเลย"): played by the server like the
# script's, only those a person signed (words + recording). While any is served the story tool above is not offered.
CEREMONY_EXTRA_LINES=true
CEREMONY_LOGO_AFTER_S=4
# "ถ้าเอาซับไทยที่หุ่นตอบพอ ไม่มีซับคนพูด จะไวไหม" (owner 24 Nov): live first only -- the hall screen's Thai subtitle of HER live answers
# (app/live_subtitle.py): her transcript a sentence at a time, translated by a fast Gemini text model off the event loop (never delays her
# audio; a failed or 2.5 s-late sentence shows nothing), shown when the screen's audio clock reaches it. Never the host's words, never English.
# Needs a paid key: the free tier's 15 requests a minute on the default model ran out after 15 sentences (measured 24 Nov).
CEREMONY_LIVE_SUBTITLE_TH=true

# The reloader watches files and drops every WebSocket on a restart.
DEV_RELOAD=false
# Playwright/Chromium windows do not exist on Android (Canva, web stage).
WEB_STAGE=false
CANVA_OPEN_AT_START=false
# The PC's index (embeddings.npz) is local MiniLM built with torch. The robot
# has no torch: it runs the ONNX export of the same model (app/embed_onnx.py,
# measured equal to the PC's vectors -- same index, no rebuild), fetched on
# `deploy` (FETCH_ON_ROBOT). Files missing or unverifiable = lexical (BM25)
# with one log line, as before.
EMBED_PROVIDER=local
# Never build a whole index here (15 Oct): the report FAQ's cache was not
# shipped, so every app start embedded 299 questions on the robot -- and the
# robot hard-reset ~25 s in, six times 17:53-18:28 (bootloader "(none)", no
# Android shutdown). A stale cache now means search by words + one log line;
# `deploy` ships the PC's caches (faq_embeddings.npz too).
EMBED_BUILD=false

# The board is inside the robot: no adb forward on this side.
ROBOT_CHASSIS_URL=http://192.168.11.1:1448
# The arm belongs to the face app (CH340 via the Aobo SDK); the server's
# adb-printf path has no adb here.
ROBOT_ARM_ADB=
ROBOT_ARM_ADB_SERIAL=

# Greeting with the handshake (group 6) for EVERYONE the camera greets (owner
# 10 Oct: "เอาท่าจับมือท่า 6 ทักทายทุกคนที่หุ่นเห็นหน้า") -- strangers and
# groups too, not only named people (9 Oct's rule, FACE_HANDSHAKE_NAMED_ONLY
# below, now off). Still no greeting at all mid-conversation (owner 30 Sep:
# ประโยคทักทายไม่ให้พูดแทรก), and the app still refuses gestures while
# walking / latched / busy / over its per-minute cap.
ROBOT_GREETING_GESTURE_ENABLED=true
ROBOT_ARM_MOTION_ENABLED=true
# Base motion from the server stays off (bring-up 9 Oct); walks run from the
# face panel through the launcher, which does not use this switch.
ROBOT_CHASSIS_MOTION_ENABLED=false

# "Probably someone we know" (owner 9 Oct: far face, not sure → check first):
# hold the stranger greeting, never say a name while unsure, ask the
# face page for a sharp crop (40 px faces named 25 -> 30 of 35 in the eval).
# 8 s -> 3 s on 13 Oct (owner: "ทักช้า"): greetings came 15-38 s after the
# camera opened the call, the 8 s hold expiring on a close face that the
# detector finds for one frame at a time. A known face is still named when
# sure; past 3 s an unsure one is greeted without a name.
# 3 s -> 0 later on 13 Oct (owner: "ทักช้า ... กล้องตัวหุ่นไม่ค่อยดี"): on this
# camera every close arrival scores in the "probably known" band (29 of 29
# on 12-13 Oct, faces 209-577 px) and 28 of them were lost before the hold
# ended -- the hold delayed the greeting of nearly everyone and named nobody.
# Off = greet as soon as 2 frames agree; a known face is still named when sure.
FACE_PROBABLE_WAIT_S=0
# The PC waits 3 s for a sharp frame before calling an arrival a stranger;
# here the face is gone by then, so the greeting never came (ears opened
# "greeted: False" 9-10 s after the dial on most 12 Oct calls).
FACE_TRACK_WAIT_S=0
# A summoned call is deaf until its greeting is heard; if none comes, this
# long (code default 10 s) -- a guest who spoke first was ignored meanwhile.
SUMMONED_HOLD_MAX_S=4
FACE_ZOOM_ENABLED=true
# Scan faster (owner 5 Nov: "ปรับเรื่องการแสกนหน้าให้ไวยิ่งขึ้น"), measured on the real head
# camera's frames with the real models (docs/emma-face-approach.md section 10): the detector at 320
# finds the same faces in a 1024 px frame (135 faces: mean score change +0.000, same decisions and
# names 9 of 9 arrivals, nobody under 0.42 reached 0.5) at a quarter of the cost: an empty frame 166 -> 34 ms,
# so CPU DOWN between people. A portrait for the gallery stays at 640.
FACE_DET_SIZE=320
# The frames of a name being confirmed come at once, at least 0.3 s first to last (a stranger keeps
# FACE_FPS's pace: closer-together frames would greet a colleague anonymously on their way in), no
# 0.4 s pause before a greeting nothing plays before, and face_perf + track_s rows: how long frames
# really take here.
FACE_FAST_CONFIRM=true
FACE_HANDSHAKE_NAMED_ONLY=false
# Several faces at once = one greeting for everyone, no name (owner 2 Nov:
# "คำทักรวมบนหุ่นใช้ภาษาอังกฤษ", "ทักกลุ่มแล้วยังยื่นมือจับมือ" -- the handshake
# above stays on for groups). English here, like every first greeting on the
# robot (8 Oct). docs/emma-multi-person-2026-11-02.md.
FACE_GROUP_GREETING=true
# Owner 6 Nov: "ไม่เห็นทักเลย". The standing line opened at boot, two staff talking to each other
# near the robot were heard 20 s later, she answered once, and the line was "a conversation" for
# every face after it (two she knew) until 120 s of silence that never came. Now a used line is
# a conversation only while she talks with somebody: speaking, an answer on its way, or her last
# words under this many seconds ago. Somebody mid-sentence: the greeting waits (8 s at most).
# 20 = the guest's reply window (10 s, FOCUS_REPLY_WINDOW_S) plus her follow-up (4 s) and margin.
FACE_GREET_LAPSE_S=20
# Turning toward a far face: off -- the robot is docked most of the time, routes
# own the base (nudge refuses routes_own_the_base), and a yaw-only MoveTo has
# never been seen to rotate in place on this board (needs a bench test first).
FACE_TURN_TO_CHECK=false

# The นำทาง slot on the face's hold menu (owner 9 Oct: "ยังไม่เห็นฟังก์ชั่น
# นำทางเลย"). `open` is the owner's choice (9 Oct, "ไม่ใช้ PIN"): anyone at
# the face can start a walk with the 1 s hold -- `pin` + ROBOT_NAV_PIN in the
# PC's .env is the safer mode for a room with customers.
# The robot app's own switch (operator screen: hold top-left 3 s ->
# "ฟังก์ชันนำทาง") must be on too. Voice starts stay off (ROBOT_NAV_VOICE).
# 28 Oct (owner): the robot goes down to floor 1 today -- every route is
# floor 2's (walls, doors, dock), so the panel's walk slot is off until it is
# back on floor 2 (set true again, `secrets`, `restart`). Joystick unaffected.
ROBOT_NAV_ROUTES_ENABLED=false
ROBOT_NAV_PANEL=open

# Listening focus (docs/listening-focus-2026-10-09.md), first supervised
# trial 9 Oct: answer only the person in front of the camera. Owner: the robot
# answered people chatting nearby. Rollback = FOCUS_ENABLED=false.
FOCUS_ENABLED=true
FOCUS_REQUIRE_FACE=true
FOCUS_FACE_MIN_PX=60
# Facing rule off (owner 9 Oct: "การหันหน้าเข้ากล้องเอาออกดีกว่า"); size still decides.
FOCUS_YAW_MAX_DEG=0
FOCUS_HOLD_S=2.0
# 13 Oct (owner: "คุยด้วยไม่ค่อยตอบ ... ทักช้า"): 12-13 Oct logs had 1,065
# segments denied "no face in front" to 86 opened. A guest at the chest
# screen is under the head camera, or found for one frame and lost. After a
# face-verified segment, 20 s without a face is still the conversation; a
# voice at >= 0.06 (opened p50 0.057, room chatter 0.02-0.04) is at the robot.
# Simulated on those logs: ~120 more segments heard, the chatter still out.
FOCUS_CONVERSE_HOLD_S=20
FOCUS_NEAR_RMS=0.06
# The hold above starts only from a face-verified segment -- and on 12 Oct
# all 983 denials had no face at all, so it rarely started. Turn-taking
# instead: a voice that starts within 10 s after her voice ended (greeting
# or answer) is the guest answering her. Chatter lands only inside that
# window; the 0.02 floor below still applies. Tune from "reply to her" rows.
FOCUS_REPLY_WINDOW_S=10
# At a room's big screen (the pose inside its `near` area, or its face up on
# that TV within radius + 1 m) people watch the TV, not the head camera: 28 Oct
# in the media room a usable face in 1 of 297 decisions, testers' first
# sentences refused at 0.031/0.044. Owner 29 Oct: "ผ่อนเลย ฟังจากเสียงที่ได้ยินชัด".
# There a voice reaching 0.03 opens without a face (the 0.02 floor and Silero
# still apply) and the 30 s "no face" hang-up and follow-up veto stand down.
# Replay of 28 Oct at the screen: of 84 voices refused there, 29 clear at their
# first frame (0.04: 8). 0 = off (everywhere else, and the sales-room PC).
FOCUS_SCREEN_RMS=0.03
# Near voices in, far voices out, by the lidar (app/near_voice.py; owner 5 Nov: "ฟังเสียงคนใกล้
# คนไกลออก"). SHADOW = the focus rows say what it would have done, and she hears exactly what
# she hears today: one setting more per door frame and a read of the head's own lidar poller,
# no new scan. Replay of 4-5 Nov: 19 of 22 voices "for her" kept, 18 of 39 "not for her"
# refused, level alone at the same refusals keeps 14 of 22 -- but 94 voices and noisy labels, and
# nobody has stood at a known distance yet. Set `on` only after docs/near-voice-bench.md.
VOICE_NEAR_DOOR=shadow
# Labels to Gemini: unmeasured (may hold a reply; read-aloud unknown).
FOCUS_SPEAKER_LABELS=false
# Mouth movement at 10 fps first: robot CPU is unmeasured (watch "asd:" lines).
ASD_ENABLED=true
ASD_FPS=10
# Voice prints: threshold measured on PC audio, not on the far-field array.
VOICEPRINT_ENABLED=false
# Reception-robot engagement, phase 1 (10 Oct; review's recommendation).
# "Emma" said during a call opens 10 s in which an out-of-view caller is heard
# (Look and Talk's "say the name outside the zone"); the mascot looks toward
# whoever speaks (Furhat). Invite / goodbye / full engagement wait for a day
# of focus_wake and focus_gap rows (scripts/analyze_log.py).
FOCUS_WAKE=true
FOCUS_WAKE_THRESHOLD=0.10
FOCUS_WAKE_WINDOW_S=10
FOCUS_ATTENTION=true
# The first person keeps the robot until they leave (owner 2 Nov: "ให้คนแรกคุย
# จนเดินออกไปก่อน แล้วจึงเริ่มบทสนทนาใหม่กับคนถัดไป"). On this robot today that
# is the mascot's eyes (and the head, with HEAD_FOLLOW) staying on the main
# person: refusing the second person needs a moving mouth or a voice direction,
# and neither has ever produced a value here (ASD 0 faces in 247 reports, DOA
# off) -- the array mic work (docs/emma-array-mic-2026-11-02.md) is that part.
FOCUS_ENGAGE_MODE=full
# Several people and nobody speaking: the eyes visit each in turn (owner 2 Nov,
# "สบตาหรือหันหน้าไปหาทีละคน"); 3 s for the eyes alone. The real head no longer
# visits (HEAD_FOLLOW_FIRST, 10 Nov). In full mode the main person, once there
# is one, keeps the eyes.
FOCUS_GAZE_VISIT_S=3
FOCUS_INVITE=false
FOCUS_INVITE_DENIED_N=0
# The goodbye that starts a fresh conversation for the next person stays OFF
# (measured 2 Nov, 11 days of robot logs, 516 focus_gap rows): a face missing
# >= 8 s that came back with no voice in between -- a goodbye said to a guest
# still in front -- 35 times at 8 s, 20 at 12, 8 at 20, 4 at 30. The head
# camera loses the person standing at the screen; re-measure after the
# HEAD_FOLLOW test: python scripts/replay_goodbye.py.
FOCUS_GOODBYE=false
# Mic-array direction: OFF -- the concurrency test failed (10 Oct, measured):
# the Bothlent array gives Android ONE capture stream. App first (8 ch) = the
# WebView's call mic reads exact zeros the whole call (Emma deaf, 37 reports);
# page first (2 ch) = the app gets 2 of 8 channels, the rest zero. Direction
# and ARRAY_AUDIO need the app to be the array's only owner first.
DOA_ENABLED=false
# The robot's call had no loudness floor at all (joke is in LISTEN_FAR_PROFILES).
# 0.02 cuts ~1.5% of today's real openings; 0.04 would cut ~21% (9 Oct log).
VAD_MIN_RMS_FAR=0.02
# The floor and focus above re-ask on every frame and let a sentence in on
# its loudest syllable; the pre-roll was only 0.3 s, so the head was gone
# (28 Oct media room: 73/124 opens within 2 s of a denial, first words heard
# as only their last word). Keep up to 1.5 s more of the speech they still refuse.
VAD_HEAD_HOLD_MS=1500

# Debug audio dumps fill the robot's disk with customer voices.
WAKE_DEBUG=false
CALL_DEBUG=false
# Rehearsal 24 Nov 11:25: Khun Miki on the GCK collar mic (rms ~0.02-0.03, no face in the lens) was refused
# "no face in front" on every sentence. Owner: "เอาเรื่องกล้องไม่เห็นหน้าออกเลย ฟังเสียงจากไมค์พอ" -- in the
# ceremony's live window focus ignores the camera (the call's sound floors still apply). Rollback = false.
CEREMONY_MIC_ONLY=true
# Owner 24 Nov rehearsal: "ทำไมยังพูดไทยเอาออกเลย" -- the ceremony call speaks English only (language pin + a rule
# in the ceremony block + the live brief); the Thai subtitle stays on the screen. Rollback = false.
CEREMONY_ENGLISH_ONLY=true
