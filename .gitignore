.env
# Local diagnostics and proprietary robot delivery files
debug.log
vendor/aobo/incoming/
# Scratch extractions — Android SDK/Gradle/toolchain + robot SDK dumps (~15k files,
# hundreds of MB). Never tracked; this is what made the SCM show "10000 changes".
.tmp/
# Emma -> UE5 package (~20 MB of FBX/GLB/PNG). One command rebuilds it:
# blender --background --python scripts/export-emma-ue5.py
/exports/
tools/android/platform-tools/
tools/android/*.zip
tools/android/download-receipt.json
tools/android/xbox-direct/
# Local HTTPS private key and certificate (regenerate with mkcert per machine)
certs/
__pycache__/
*.pyc
.venv/
.venv-smoke/
.uv-cache/
data/eval-runs/
venv/
.pytest_cache/
# Scratch run directories from `pytest --basetemp=...`. Seven of them had
# collected at the repo root; none are worth a line in anyone's diff.
.pytest_*/
.pytest-*/
.pytest-tmp-*/

# Hub identity (MAC/IP of the Broadlink device on your network)
data/broadlink_device.json
# scripts/learn_ir.py: the codes file as it was before a learning session
# (the undo), and the half-written file of an interrupted atomic save.
data/ir_codes.json.bak
data/ir_codes.json.tmp

# Cached slide embeddings — rebuilt from the deck on first run
data/slides/embeddings.npz
data/projects/*/presentations/slides/embeddings.npz

# Turn logs contain what visitors said out loud — never commit them.
data/logs/
# ผังโชว์รูมที่เจ้าของอัพโหลดเอง + ค่าจับคู่ตำแหน่ง (/mapview) — ของเครื่องนี้
data/robot/
data/documents/*.pdf

# Coverage output
.coverage
htmlcov/

# Slide images exported from the Canva deck — 123 MB of a client's sales
# material, and rebuildable in one command, so they don't belong in history.
#   python scripts/import_slides.py deck.pdf --prefix ew
# index.json IS committed: the narration scripts and questions live in it and
# are the part that took work.
data/slides/*.jpg
data/slides/*.jpeg
data/slides/*.png
data/slides/index.json.bak
data/projects/*/presentations/slides/*.jpg
data/projects/*/presentations/slides/*.jpeg
data/projects/*/presentations/slides/*.png
data/projects/*/presentations/slides/index.json.bak
# Per-unit plan crops + their index (scripts/build_unit_plans.py, generated
# from the sales team's furniture PDFs — ~1,066 images, rebuilt not tracked).
data/projects/*/sales/unit-plans/
# Backups the data console keeps beside any file it rewrites (app/data_console.py).
# The .bak is the undo for a wrong approval; it is local evidence, not history.
data/projects/*/facts/*.json.bak
data/projects/*/presentations/*.json.bak
data/projects/*/sales/*.json.bak
data/review/other_projects/presentations/slides/*.jpg
data/review/other_projects/presentations/slides/*.jpeg
data/review/other_projects/presentations/slides/*.png
data/review/unindexed_slides/

# Aggregate counts kept past the raw logs. No guest speech in them, but they
# are this gallery's numbers, not the project's.
data/log-summaries/

data/eval_query_cache.npz

# Working folders from scripts/import_canva_export.py. Both are copies of
# the client's sales deck — hundreds of megabytes of it — and the backup is
# the *previous* deck, which is exactly the thing that must not end up in a
# repo shared with anyone.
data/slides-backup/
data/canva-render/
data/canva-shots/
data/projects/*/presentations/slides-backup/
data/projects/*/presentations/canva-render/

# Wake-word model — 30MB of ONNX weights, restored with one command:
#   python scripts/fetch_wake_model.py
data/wake/
data/wake_debug/
data/wake_enroll/
data/call_debug/
data/emma-corpus/

# Emma's timers, reminders and memory — the owner's own data, not the repo's
data/reminders.json
data/memory.json
data/personal-docs/
# The mic array's learned lag->bearing map (app/doa.py): written by the
# server on the robot itself. Untracked-but-not-ignored would ride the next
# robot_server deploy and overwrite the robot's own calibration.
data/doa_calibration.json
data/doa_calibration.json.tmp
# ARRAY_CAPTURE8: raw 8-channel room audio for the channels 4-7 test, deleted
# by the server after ARRAY_CAPTURE8_KEEP_MIN — and never in the history.
data/array_capture8/
# ENHANCE_ENABLED's GTCRN model (535 KB, sha256-pinned):
#   python scripts/fetch_enhance_model.py
data/enhance/

# Face models (280MB, restored with one command) and everything built from
# the enrolment photographs. The gallery is a file of vectors, not pictures,
# but it is still a list of who works here and who has walked in — it is the
# owner's data, like data/memory.json, not the repo's.
#   python scripts/fetch_face_model.py
data/faces/

# ONNX export of the local embedding model (480 MB, sha256-pinned in
# app/embed_onnx.py; the robot downloads it itself on deploy):
#   python scripts/fetch_embed_model.py
data/models/

# The push-deploy target list (scripts/deploy_room_agents.ps1): internal
# hostnames/IPs of approved company PCs, hand-maintained. Names infrastructure,
# so it stays out of the repo.
data/room-deploy.json
# Python installer cached once on the server to bundle into room packages (25 MB).
.tmp/python-cache/
# The deploy audit log: which agent went to which host, when, by whom. Local
# operational record, never a token or a password in it, but not history.
data/room-deploy-log/

# Which machine is in which room, and the token for each (scripts/room_control.py).
# One shared secret per sales-room PC. A token in the history is a token that has
# to be changed on every machine it was ever used on.
data/rooms.json

# What the room agent writes on the machine it runs on (app/room_agent.py):
# full-desktop screenshots and a per-day action log. The screenshots are
# whatever was on a sales-room monitor at that moment -- a customer's details,
# an inventory sheet, someone's mail -- and they are taken by a service driven
# from another machine, so nobody is standing there deciding to keep them.
# Same rule as data/logs/: it is local evidence, it is not history.
data/room-agent/

# Showroom CAD model and derived maps are site-specific local references.
data/showroom/

# Hardware inspection and maps contain site-specific information.
data/robot-inspection/

# Generated Gradle state and Android build output for the Emma voice app.
apps/emma-ai-voice/.gradle/
apps/emma-ai-voice/app/build/
# Android build artefacts for every app module (source stays tracked)
apps/*/.gradle/
apps/*/app/build/
apps/*/build/
apps/*/local.properties

tools/android/scrcpy/
.tmp/scrcpy-*.zip
