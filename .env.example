# Copy to .env and fill in. You only need the key for the provider you use.

# --- Which speech-to-speech provider ---
# gemini = Google Gemini Live, has a FREE TIER  (start here)
# openai = OpenAI Realtime, paid per audio minute
VOICE_PROVIDER=gemini

# --- Gemini (free tier) --- get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore
# Used only if GEMINI_MODEL cannot be opened at all — a preview model that has
# been withdrawn, renamed, or rate-limited. Blank turns the fallback off.
# A dropped connection does NOT trigger it; that still fails loudly.
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-native-audio-preview-12-2025
# Adapts the reply's tone to the guest's tone (native-audio models only).
GEMINI_AFFECTIVE_DIALOG=true
# Lets the robot stay quiet when speech clearly isn't aimed at it. Useful in a
# busy gallery, but it will sometimes ignore a real question — try it before
# turning it on for a demo.
GEMINI_PROACTIVE_AUDIO=false
# Gemini 2.5 native audio thinks before answering by default, which delays the
# first spoken word. 0 = off (lowest latency). Raise if answers feel shallow.
GEMINI_THINKING_BUDGET=0
# Used instead of the budget on gemini-3.x Live models.
GEMINI_THINKING_LEVEL=minimal

# --- OpenAI (paid) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_TURN_DETECTION=semantic_vad     # semantic_vad | server_vad
OPENAI_VAD_EAGERNESS=medium            # low | medium | high | auto

# --- Turn taking (both providers) ---
# 500-800ms is the documented sweet spot. Lower fragments an utterance at
# natural pauses and hurts quality; higher just feels sluggish.
VAD_SILENCE_MS=500
VAD_PREFIX_PADDING_MS=300

# Gemini only. These names mean the opposite of what they sound like:
#   START LOW = detects the start of speech LESS often -> it ignores you
#   END   LOW = decides you stopped talking LESS often -> slower replies
# HIGH is the API default and what you want. Don't use LOW to stop the robot
# hearing itself — use HALF_DUPLEX below.
VAD_START_SENSITIVITY=HIGH
VAD_END_SENSITIVITY=HIGH

# Stop sending mic audio while the assistant speaks. Cures the robot hearing
# itself through the speakers and reporting constant "interrupted", but you
# lose the ability to talk over it. Try headphones first.
HALF_DUPLEX=false

# Who decides when speech starts/ends. gemini (default) streams the mic
# upstream continuously; local runs Silero VAD on this machine and forwards
# speech only — silence is never sent, so it cannot be hallucinated into
# phantom sentences (我们走吧 from a quiet room) or metered. Needs a one-time
# model fetch: python scripts/fetch_vad_model.py
# VAD_SILENCE_MS / VAD_PREFIX_PADDING_MS drive the local detector too.
VAD_MODE=gemini
# VAD_MODE=local only — near-field floor. Speech quieter than this RMS at
# the moment a segment would open is treated as silence: other people's
# conversations across the room stop reaching the model. 0 = off. The scale
# depends on the mic chain: with CALL_MIC_BOOST=1.0 (the pairing this floor
# wants — a compressor lifting far voices to near level defeats any loudness
# floor behind it) desk speech lands around 0.01-0.05; start at 0.01. Tune
# from the "vad floor: ... rms=X" log lines, not from theory: a floor set
# against the compressed scale eats the owner's own speech (happened here).
VAD_MIN_RMS=0
# Mic boost during a call, when different from MIC_BOOST (standby). The two
# modes want opposite microphones: standby hears the wake word from across
# the room; a call is one person at the desk. Blank = same as MIC_BOOST.
CALL_MIC_BOOST=

# The two noise amplifiers, separately switchable. MIC_COMPRESSOR is the
# squeeze half of MIC_BOOST's far-field recipe — it lifts everything quiet,
# including the room's own noise floor (measured: hiss at "speech" level
# with nobody talking, a level bar that never rests, a keyword spotter
# listening through it). MIC_AGC is the browser's auto gain — in a quiet
# room it hunts upward until the noise floor reaches its target. Turn off
# one at a time and judge by the standby level bar at rest.
MIC_COMPRESSOR=true
MIC_AGC=true

# End a session after this many seconds with no *guest* speech. 0 = never.
# A guest walking away produces no event: the socket stays open and the
# connection stays billed. Measured on guest speech only — a robot narrating
# 65 slides to an empty room is what this is for, and it is busy throughout.
# 600 (ten minutes) is a sane gallery value. Leave 0 while demoing.
IDLE_TIMEOUT_S=0

# --- Persona ---
# Which hat the assistant wears. One repo, two personas — same engine,
# same bug fixes, different rules of engagement:
#   condo  (default)  the gallery receptionist: talks to strangers, condo
#                     topics only, gets every tool group
#   emma              the owner's personal assistant: talks to its owner,
#                     any topic, and (with TOOL_GROUPS blank) only the
#                     smarthome tools — slides/documents/robot are gallery
#                     equipment. See docs/jarvis-roadmap.md
# A typo here gets you the receptionist, never a half-configured persona.
ASSISTANT_PROFILE=condo

# Open the voice session the moment the page loads — no button, no wake
# word. The trade is explicit: an open session meters free-tier quota the
# whole time the tab is up (the wake word exists to avoid exactly that).
# Off by default so the gallery keeps its morning routine.
AUTO_CONNECT=false

# Emma's timers/reminders live here (survive restarts; never committed)
REMINDERS_FILE=data/reminders.json
# Permanent facts Emma keeps about the owner ("จำไว้ว่า...") — rides in her
# prompt every session. Owner's data: never committed, never on a log clock.
MEMORY_FILE=data/memory.json
# Drop .txt/.md/.pdf files here and Emma can search them by voice — new
# files are picked up on the next question, no restart. Private, never
# committed.
PERSONAL_DOCS_DIR=data/personal-docs

# Shared secret for every WebSocket (/ws, /ws/wake, /ws/display). REQUIRED
# the moment HOST leaves 127.0.0.1 — this server opens programs and presses
# keys on the machine; an open LAN socket is an invitation. Every page must
# then be opened as .../?token=<value>. Empty = no check (localhost only),
# and since HOST below defaults to 0.0.0.0 the server says so at startup.
#
# It rides in the query string, so it lands in the server's access log and
# in browser history. Accepted knowingly: this is a shared secret for one
# LAN, not an identity, and the alternative (a header) is not something a
# plain browser page can attach to a WebSocket. Rotate it by editing here.
WS_TOKEN=

# Minutes the finished conversation stays readable on screen after the line
# goes to sleep, before the page wipes it. The countdown starts when the line
# sleeps, so saying the name again inside the window keeps the thread on
# screen instead of starting blank. 0 = never wipe (a desk only one person
# reaches). Do not use 0 in a showroom: it leaves one visitor's conversation
# on the screen the next visitor walks up to.
TRANSCRIPT_KEEP_MIN=5

# --- Unit table (the sales team's spreadsheet) ---
# room / building / floor / type / sqm / aspect / price_thb / status, plus
# approved_by and effective_from. `show_unit` reads it and renders the card;
# the assistant only ever picks a room number, never a price.
UNITS_FILE=data/units.json
# Fall back to data/units.sample.json when the real table is missing.
# LEAVE THIS OFF anywhere a customer can see the screen: the sample's prices
# are invented. It exists so the card can be shown to the sales team before
# their spreadsheet arrives — the card watermarks itself and Emma is told to
# say so out loud, but this setting is the defence that does not depend on
# anyone remembering.
UNITS_SAMPLE=false

# Live link to the sales team's inventory system (the condo-inventory repo's
# Supabase). When both are set, show_unit/find_units answer from it — the
# status is real at the moment of asking, every change in it has a person
# attached, and UNITS_FILE/UNITS_SAMPLE are ignored. Copy the values from
# condo-inventory/.env.local BY HAND (the key is the service-role secret:
# read-only use here, bypasses RLS, must never leave this machine):
#   INVENTORY_SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL
#   INVENTORY_SUPABASE_KEY = SUPABASE_SERVICE_ROLE_KEY
INVENTORY_SUPABASE_URL=
INVENTORY_SUPABASE_KEY=
INVENTORY_CACHE_S=30
# Show exact prices on the card/list. Off = prices never leave the server
# (they still filter budget questions server-side); the screen says to ask
# the sales desk. The pricelist is negotiation material — showing it is a
# sales-team decision, so it is an explicit switch, not a default.
UNITS_SHOW_PRICE=false

# --- Web stage: "เปิดอันนั้นขึ้นจอ" ---
# Open pages in a Chromium window this server drives, instead of firing
# os.startfile at whatever browser the desktop owns. With this on,
# open_in_browser and play_youtube put the page on the screen and say so;
# close_web_page closes it.
#
# A real window, not an <iframe> in /display, because most of the web sets
# X-Frame-Options and renders as a blank white rectangle with no error —
# Canva's own links do, which is why canva_display exists at all.
#
# Needs playwright (the same install the Canva mirror uses).
WEB_STAGE=false
WEB_STAGE_KIOSK=true
# "chrome"/"msedge" drive the installed browser; blank uses bundled
# Chromium, which ships without proprietary codecs — some YouTube videos
# come out audio-only or refuse on it.
WEB_STAGE_CHANNEL=chrome

# --- Web search backends ---
# Gemini's native google_search grounding (fast, in-session) needs billing:
# on a free key it kills every session with 1011. Probe first:
#   python scripts/probe_web_search.py   -> both OK, then set true and drop
#   `websearch` from TOOL_GROUPS (one search path, not two).
WEB_SEARCH=false

# Self-hosted SearXNG as the search_web backend (free, no quota, aggregates
# engines, JSON output). When set, queries go here first; the ddgs scraper
# stays as the safety net if the container is down. One-time setup:
#   docker run -d --name searxng --restart unless-stopped -p 8080:8080 searxng/searxng
#   (then enable JSON output: in the container's /etc/searxng/settings.yml
#    add "- json" under search.formats, and docker restart searxng)
# SEARXNG_URL=http://localhost:8080
SEARXNG_URL=

# --- Wake word ---
# Say the name instead of pressing Start. Detection runs on this machine
# (sherpa-onnx keyword spotting) — no audio leaves the computer, and the
# Gemini session only opens after the name is heard, which is what makes
# leaving the page open all day cost nothing. One-time model download:
#   python scripts/fetch_wake_model.py
# Off by default: the gallery robot must not grow a hot mic on a git pull.
WAKE_ENABLED=false
# The name, as plain text. The default has a precomputed encoding; any other
# word needs `pip install sentencepiece` and a real-voice test before trust.
WAKE_WORD=emma
# Detector shape: raise WAKE_THRESHOLD if it fires on similar-sounding
# speech, raise WAKE_BOOST if a clear call of the name is missed — but past
# ~5 the boost measured strictly worse. Defaults are the 2026-08-25 measured
# optimum for a Thai "เอ็มม่า" (see app/wake.py).
WAKE_BOOST=3.0
WAKE_THRESHOLD=0.10

# Log what the standby microphone is really sending, every ~2s, while it
# waits for the name. Turn on when "I said the name and nothing happened":
# it tells a silent input device apart from a room-noise-only level apart
# from real speech that the keyword simply did not match. Off after.
WAKE_DEBUG=false

# Spellings to listen for, overriding the built-in list (EMMA,IMMA). Turn
# WAKE_DEBUG on first: if it says SILENT, no spelling will help. Blank = the
# list in app/wake.py. Adding spellings is NOT free: they compete inside one
# decoder beam, and the measured five-spelling list caught *fewer* real
# calls than the measured two (see app/wake.py). Keep ordinary English words
# out — a name that fires on the room's conversation is worse than one that
# needs saying twice.
WAKE_SPELLINGS=

# --- Project identity ---
# Write it exactly as it should be SPOKEN — the assistant says this name out
# loud. A vague or lowercased name is one it will "correct" into something
# that sounds similar ("Embassy World" -> "Ambassador World").
PROJECT_NAME=Embassy World
# Optional name for the robot itself, so it introduces itself like a real
# receptionist ("สวัสดีค่ะ เอ็มม่านะคะ"). Leave blank for a generic intro.
ROBOT_NAME=

# Which languages the assistant may reply in.
#   auto     = mirror whatever the guest speaks (Gemini native audio covers
#              ~97 languages and switches mid-conversation on its own)
#   th,en    = restrict to a list; the first entry is what it opens with
# Restrict only if sales staff can't follow up in the other languages —
# foreign buyers are a real segment for Thai condos.
REPLY_LANGUAGES=auto

# How the ON-SCREEN TRANSCRIPT picks a language (Gemini only). Separate from
# REPLY_LANGUAGES — the model is speech-to-speech and understands the guest's
# audio directly, so this only affects captions. It can never stop the robot
# from replying in a language.
#
# These are HINTS, not a whitelist — detection still runs, just biased. Left
# on "auto" the recogniser guessed English for Thai speech and romanised it
# ("ao rummy"). Add codes if a language is captioned badly; "auto" restores
# full detection. Project names and hardware commands are hinted either way.
TRANSCRIBE_LANGUAGES=th-TH,en-US,zh-CN

# The recogniser sometimes word-spaces Thai ("เอา ทุก คน เลย"); Thai isn't
# written that way. Setting this to true collapses a space whenever both
# sides are Thai — "โครงการ Embassy World" keeps its spaces either way.
# Off by default: it also removes the spaces Thai legitimately uses at
# clause boundaries ("ขอโทษค่ะ ยังไม่มี..." -> "ขอโทษค่ะยังไม่มี..."). Try
# TRANSCRIBE_LANGUAGES first; only turn this on if the spacing persists.
THAI_SPACING=false

# --- Slide search ---
# Semantic (embedding) search alongside BM25, using the same GEMINI_API_KEY.
# This is what lets a question find a slide that shares none of its words:
# สระว่ายน้ำ -> "SKY POOL", or a Chinese guest's 游泳池 -> anything at all.
# The 144 slides are embedded once and cached to data/slides/embeddings.npz,
# so the running cost is one short embedding per lookup. Set false to run
# purely lexically; everything still works, just without synonyms or
# cross-language matching.
SEARCH_SEMANTIC=true
# Cosine thresholds: how similar before a slide counts as an answer, and
# before it may take over the screen. MEASURED on the Embassy World deck with
# scripts/eval_search.py — the old 0.45/0.60 were guesses and let every
# off-topic question through, including "zzzz ไม่มีอยู่จริง qqqq".
#
# The gap they sit in is narrow: the best nonsense scores 0.649 and the worst
# cross-language question 0.660. That works, but it is 0.011 wide, so re-run
# eval_search.py after changing the deck rather than trusting these numbers.
# The durable fix is keywords on the slides being missed, not the numbers.
SEARCH_MIN_SIMILARITY=0.653
SEARCH_LOCAL_MIN_SIMILARITY=0.389
SEARCH_LOCAL_SHOW_SIMILARITY=0.46
SEARCH_LOCAL_MIN_COVERAGE=0.34
PROJECT_KNOWLEDGE_FILE=data/project_knowledge.json
# Optional multilingual cross-encoder (benchmark latency on the robot first)
SEARCH_RERANKER_MODEL=
SEARCH_RERANKER_CANDIDATES=8
SEARCH_SHOW_SIMILARITY=0.68

# --- Tools (lights, air conditioner, and whatever you add later) ---
TOOLS_ENABLED=true
# Blank = load every group. Or restrict, e.g. TOOL_GROUPS=smarthome
#
# Groups: smarthome slides units calc knowledge documents robot reminders
#         memory mydocs websearch computer
#
# `units` is the room card (show_unit). It is separate from `slides` on
# purpose — the deck tools run a 65-page presentation, the card answers
# "ขอดูห้อง A801" — so Emma's machine can have the card without growing a
# sales deck. On the emma profile, name the groups explicitly to add it:
#   TOOL_GROUPS=smarthome,reminders,memory,mydocs,websearch,computer,units
TOOL_GROUPS=

# Shared test server: everyone in the office tries the assistant at once.
# Concurrent sessions stop superseding each other, machine screens go dark,
# and the tool set is forced down to shareable groups (units knowledge, plus
# mydocs/websearch if named in TOOL_GROUPS) — smarthome/computer/printer/
# robot/slides/calc/memory/reminders are stripped because they drive the one
# machine or hold one conversation's state. Still needed alongside this:
# WS_TOKEN (the LAN gate), HTTPS for the mic (Tailscale), and billing —
# free-tier Gemini caps concurrent Live sessions at about three.
MULTI_SESSION=false

# Broadlink IR hub for the gallery lights/AC. ir_codes.json is already
# populated from the emma project; broadlink_device.json holds your hub's
# MAC/IP. Without them the tools run in mock mode (state changes, room
# doesn't) which is fine for developing the conversation.
IR_ENABLED=true
IR_CODES_FILE=data/ir_codes.json
BROADLINK_DEVICE_FILE=data/broadlink_device.json

# --- Astronaut robot ---
# Movement, guiding, and stopping, through the Aobo SDK. The SDK is Android
# only and reaches the robot's navigation board on its own internal network,
# so this server never calls it directly — it sends the order down the same
# WebSocket the robot's app already uses for voice, and the app calls the SDK.
#
# false (or no robot app connected) = mock mode: the tools work, nothing
# moves, and every result says `hardware: "mock"`.
ROBOT_ENABLED=false

# The robot app's own credential, sent inside its robot_ready message. Not
# WS_TOKEN: that one is in every browser's URL on the LAN, and a page that
# has it must not be able to become "the robot". Empty = no socket is ever
# accepted as the robot. Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
ROBOT_TOKEN=

# Seconds a walk may take before the server gives up waiting for
# robot_arrived, cancels the navigation and tells the model the truth.
ROBOT_ARRIVAL_TIMEOUT_S=120

# Pretend destinations for rehearsing the guiding conversation without a robot.
# Ignored as soon as a real robot reports its own map. Nothing moves either way.
ROBOT_MOCK_PLACES=ห้องตัวอย่าง,สระว่ายน้ำ,ฟิตเนส,โต๊ะเซลส์

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
SSL_CERTFILE=
SSL_KEYFILE=


# Slide deck shown on /display (and the robot's chest screen). Import a Canva
# PDF export with: python scripts/import_slides.py deck.pdf
SLIDES_DIR=data/slides

# --- Optional: mirror the presentation on the real Canva window ---
# Canva's view links refuse to load inside an iframe (X-Frame-Options), so
# there is no way to embed the live design in a webpage — confirmed by hand,
# it's not a "haven't gotten to it yet". What DOES work: opening the same
# view link as its own real, top-level Chromium window and driving it with
# Playwright, exactly like a person clicking through would. That's what this
# does when CANVA_URL is set — every slide change also sends this window to
# the matching Canva page (deep link by page number, e.g. .../view#42, which
# jumps straight there without clicking through 1..41 first).
#
# Leave blank to skip all of this and only use the exported images (default).
# To use it: pip install playwright && playwright install chromium
#
# Paste the same "view" share link the deck was exported from:
CANVA_URL=
# Prefix the deck was imported under (scripts/import_slides.py --prefix),
# so slide id `ew-042` is known to mean "page 42 of this Canva design".
CANVA_DECK_PREFIX=ew
# false = a real window you can see (what you want for an actual display).
# true = no window, only useful to sanity-check this without a screen.
CANVA_HEADLESS=false
# Fullscreen, no browser chrome — what you want on the robot's screen.
CANVA_KIOSK=true
# Open the window at server start instead of when a presentation begins.
# Off by default so a fullscreen browser isn't sitting over your desktop
# while you work. Startup checks Chromium either way (headlessly), so a
# broken install is still reported straight away.
CANVA_OPEN_AT_START=false
# How often to check whether somebody moved the Canva deck by hand, so the
# robot can narrate the page they went to — a salesperson can drive the deck
# and the robot follows. 0 leaves the deck entirely robot-driven.
CANVA_POLL_S=1.0

# --- Narrated tour pacing ---
# Beat between slides, after the previous narration has finished playing.
SLIDE_PAUSE_S=0.8
# Longest next_slide will hold the model waiting for the guest to finish
# hearing the previous slide. Holding it is what keeps picture and words
# together, but it parks the model mid-turn for that long. If a tour
# narrates a few slides and then goes silent, lower this first — an early
# slide beats a tour that stops.
SLIDE_TOOL_BUDGET_S=6.0

# --- Turn log -------------------------------------------------------------
# One JSON line per turn in data/logs/YYYY-MM-DD.jsonl: what was heard, what
# was said, which tool ran, which slide went up and how far the audio queue
# was ahead at that moment. This is what makes "ทำไมสไลด์ไม่ตรง" answerable
# from data instead of from memory.
#
# It records what visitors say out loud. No audio is ever written, only text,
# and data/logs/ is gitignored — but it is still strangers' speech on disk in
# a public showroom, so it is a decision worth making deliberately.
TURN_LOG=true
TURN_LOG_DIR=data/logs

# How many days of raw transcripts to keep. 0 = forever.
# These hold what visitors said out loud, including phone numbers the robot
# reads back to confirm. Analysis doesn't need them: run
#   python scripts/analyze_log.py --days 30 --save
# to keep counts and topics in data/log-summaries/, which outlive the deletion
# and contain nothing anyone said.
TURN_LOG_KEEP_DAYS=30

# --- Embeddings -----------------------------------------------------------
# Which backend builds the slide search index.
#   auto    prefer the Gemini API, fall back to local when there is no key
#   gemini  API only
#   local   offline, no quota — needs: pip install sentence-transformers
#   off     keyword search only
#
# Changing this rebuilds the index, and that is not optional: vectors from two
# different models are not comparable. Comparing them does not error, it just
# ranks slides at random — so the provider is part of the cache's identity.
EMBED_PROVIDER=auto

# --- Documents & printing -------------------------------------------------
# The robot prints only files listed in data/documents/catalogue.json. It
# never creates a document — the sales team writes them and owns what they say.
DOCUMENTS_DIR=data/documents
PRINT_ENABLED=true

# SET THIS EXPLICITLY. Leaving it blank uses the Windows default printer, and
# "Let Windows manage my default printer" makes that the *last printer used* —
# which can be "Microsoft Print to PDF". That one does not print: it opens a
# Save-As dialog and waits for a human, while the robot tells the guest the
# document is on its way.
#   PRINTER_NAME=Brother DCP-L3560CDW series Printer
PRINTER_NAME=

# Paper does not come back, and a mishearing lands on this number. A real
# transcript from this project contained "อะไรนะ 50".
PRINT_MAX_COPIES=3

# Optional, and the right answer for a kiosk. Windows can only "print" a PDF
# via the shell if some application is associated with .pdf — and on a machine
# that has been reimaged, or set up by whoever was free that day, it often
# isn't. Then every print fails with "No application is associated", which
# reads like a printer problem and is not one.
#
# SumatraPDF is ~10MB, portable, and needs no install:
#   https://www.sumatrapdfreader.org/download-free-pdf-viewer
#   PDF_PRINT_EXE=C:\tools\SumatraPDF.exe
PDF_PRINT_EXE=

# Seconds between attempts to reopen the door camera after it stops delivering
# frames (USB hiccup, the enrolment station holding it). 0 = give up until the
# next restart.
FACE_CAMERA_RETRY_S=10
