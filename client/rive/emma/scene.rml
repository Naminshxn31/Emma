                <AnimationState x="0" y="0" animationId="0:200" id="0:912"/><AnimationState x="180" y="0" animationId="0:210" reset="true" id="0:913"/><AnimationState x="360" y="0" animationId="0:220" reset="true" id="0:914"/><AnimationState x="540" y="0" animationId="0:230" reset="true" id="0:915"/><AnimationState x="720" y="0" animationId="0:240" reset="true" id="0:916"/><AnimationState x="900" y="0" animationId="0:250" reset="true" id="0:917"/><AnimationState x="1080" y="0" animationId="0:260" reset="true" id="0:918"/>
            </StateMachineLayer>
            <StateMachineLayer name="Blink" id="0:920"><AnyState x="0" y="-150"/><ExitState x="240" y="-150"/><EntryState x="-180" y="0"><StateTransition stateToId="0:921"/></EntryState><AnimationState x="0" y="0" animationId="0:270" id="0:921"/></StateMachineLayer>
            <StateMachineLayer name="Lip Sync" id="0:930"><AnyState x="0" y="-150"/><ExitState x="240" y="-150"/><EntryState x="-180" y="0"><StateTransition stateToId="0:931"/></EntryState><BlendState1DInput x="0" y="0" inputId="0:902" id="0:931"><BlendAnimation1D animationId="0:280" value="0"/><BlendAnimation1D animationId="0:281" value="100"/></BlendState1DInput></StateMachineLayer>
            <StateMachineLayer name="Look X" id="0:940"><AnyState x="0" y="-150"/><ExitState x="240" y="-150"/><EntryState x="-180" y="0"><StateTransition stateToId="0:941"/></EntryState><BlendState1DInput x="0" y="0" inputId="0:903" id="0:941"><BlendAnimation1D animationId="0:290" value="0"/><BlendAnimation1D animationId="0:291" value="50"/><BlendAnimation1D animationId="0:292" value="100"/></BlendState1DInput></StateMachineLayer>
            <StateMachineLayer name="Look Y" id="0:950"><AnyState x="0" y="-150"/><ExitState x="240" y="-150"/><EntryState x="-180" y="0"><StateTransition stateToId="0:951"/></EntryState><BlendState1DInput x="0" y="0" inputId="0:904" id="0:951"><BlendAnimation1D animationId="0:293" value="0"/><BlendAnimation1D animationId="0:294" value="50"/><BlendAnimation1D animationId="0:295" value="100"/></BlendState1DInput></StateMachineLayer>
            <StateMachineLayer name="Ambient Glow" id="0:960"><AnyState x="0" y="-150"/><ExitState x="240" y="-150"/><EntryState x="-180" y="0"><StateTransition stateToId="0:961"/></EntryState><AnimationState x="0" y="0" animationId="0:300" id="0:961"/></StateMachineLayer>
        </StateMachine>

