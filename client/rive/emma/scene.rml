<Rive version="1" kind="fragment">
    <!-- Approved Emma artwork is split into independent transparent layers.
         The animated nodes keep their original IDs so the state machine can
         drive the face, lip sync, gaze, body and complete shoulder chains. -->
    <ImageAsset file="assets/head.png" name="Emma Head Artwork" id="0:1100"/>
    <ImageAsset file="assets/body.png" name="Emma Body Artwork" id="0:1101"/>
    <ImageAsset file="assets/arm-left.png" name="Emma Left Arm Artwork" id="0:1102"/>
    <ImageAsset file="assets/arm-right.png" name="Emma Right Arm Artwork" id="0:1103"/>
    <ImageAsset file="assets/eye-left.png" name="Emma Left Eye Artwork" id="0:1104"/>
    <ImageAsset file="assets/eye-right.png" name="Emma Right Eye Artwork" id="0:1105"/>
    <ImageAsset file="assets/mouth-smile.png" name="Emma Smile Artwork" id="0:1106"/>
    <ImageAsset file="assets/mouth-open.png" name="Emma Open Mouth Artwork" id="0:1107"/>
    <ImageAsset file="assets/ring.png" name="Emma Ground Ring Artwork" id="0:1108"/>
    <!-- Every layer is cropped from one atlas that already has Emma assembled
         correctly, so the rig keeps ONE scale (0.68) for all of them and places
         each node at its atlas position mapped into the artboard:
             artboard_x = 136.06 + atlas_x * 0.68
             artboard_y = 77.48  + atlas_y * 0.68
         Scaling the parts separately (head .68, body .72, arms .60, ring .52)
         is what drifted the proportions away from the reference: arms 20% too
         close to the body and 12% too small, the ring 23% too small and 12%
         too low, the torso 8% too far below the head. Measured, not guessed -
         crop boxes live in scripts/extract-emma-rive-assets.py. -->
    <Artboard defaultStateMachineId="0:900" styleId="0:3" clip="true" width="720" height="860" name="Emma" id="0:2">
        <LayoutComponentStyle name="Emma Artboard Style" id="0:3"/>
        <Node x="360" y="390" name="Emma Rig" id="0:10">
            <Node x="-11" y="-95" name="Head" id="0:20">
                <Node name="Face Features" id="0:30">
                    <Shape x="-87" y="-17" scaleY="0.02" opacity="0" name="Left Eyelid" id="0:36"><Ellipse width="102" height="76" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFF8FAFD" name="Color"/></Fill></Shape>
                    <Shape x="87" y="-17" scaleY="0.02" opacity="0" name="Right Eyelid" id="0:37"><Ellipse width="102" height="76" name="Path"/><Fill name="Fill"><SolidColor colorValue="FFF8FAFD" name="Color"/></Fill></Shape>
                    <Node name="Mouth" id="0:40">
                        <Image x="4" y="119" scaleX="0.68" scaleY="0.68" originX="0.5" originY="0.5" opacity="0" assetId="0:1106" name="Smile" id="0:42"/>
                        <Image x="4" y="119" scaleX="0.68" scaleY="0.68" originX="0.5" originY="0.5" opacity="0" assetId="0:1107" name="Mouth Opening" id="0:41"/>
                    </Node>
                    <Image x="-87" y="-17" scaleX="0.68" scaleY="0.88" originX="0.5" originY="0.5" assetId="0:1104" name="Left Eye" id="0:34"/>
                    <Image x="87" y="-17" scaleX="0.68" scaleY="0.88" originX="0.5" originY="0.5" assetId="0:1105" name="Right Eye" id="0:35"/>
                </Node>
                <Image scaleX="0.68" scaleY="0.68" originX="0.5" originY="0.5" assetId="0:1100" name="Head Artwork"/>
            </Node>

            <Node x="2" y="182" name="Torso" id="0:50">
                <Shape y="6" opacity="0.78" name="Core Glow" id="0:54"><Ellipse width="91" height="91" name="Path"/><Fill name="Fill"><RadialGradient startX="0" startY="0" endX="46" endY="0" name="Core"><GradientStop colorValue="FFFFFFFF" position="0"/><GradientStop colorValue="CCFFFFFF" position="0.48"/><GradientStop colorValue="00FFFFFF" position="1"/></RadialGradient></Fill></Shape>
                <Image scaleX="0.68" scaleY="0.68" originX="0.5" originY="0.5" assetId="0:1101" name="Body Artwork"/>
            </Node>

            <Node x="-115" y="109" rotation="-0.18" name="Left Arm" id="0:60">
                <Node name="Left Hand" id="0:64"/>
                <Image scaleX="0.68" scaleY="0.68" originX="0.78" originY="0.17" assetId="0:1102" name="Left Arm Artwork"/>
            </Node>
            <Node x="119" y="109" rotation="0.18" name="Right Arm" id="0:70">
                <Node name="Right Hand" id="0:74"/>
                <Image scaleX="0.68" scaleY="0.68" originX="0.22" originY="0.17" assetId="0:1103" name="Right Arm Artwork"/>
            </Node>
        </Node>

        <Image x="362" y="705" scaleX="0.68" scaleY="0.68" originX="0.5" originY="0.5" assetId="0:1108" name="Ground Ring" id="0:82"/>
        <Shape x="362" y="705" name="Ground Core" id="0:83"><Ellipse width="320" height="63" name="Path"/><Stroke thickness="10" name="Glow"><SolidColor colorValue="33FFFFFF" name="Color"/></Stroke></Shape>
        <Shape x="360" y="274" opacity="0" name="Aura" id="0:80"><Ellipse width="470" height="470" name="Path"/><Stroke thickness="5" name="Aura Stroke"><SolidColor colorValue="775CD8FF" name="Color"/></Stroke></Shape>

        <StateMachine name="EmmaVoice" id="0:900">
