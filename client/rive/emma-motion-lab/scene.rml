            <KeyedObject objectId="0:711">
                <KeyedProperty propertyKey="268">
                    <KeyFrameString frame="0" value="A tour of Emma's five gestures." />
                    <KeyFrameString frame="120" value="A little anticipation. Two wrist waves. A soft return." />
                    <KeyFrameString frame="384" value="Back to rest. The next gesture follows shortly." />
                    <KeyFrameString frame="468" value="Looking left, looking right... let me check that." />
                    <KeyFrameString frame="792" value="Back to rest. The next gesture follows shortly." />
                    <KeyFrameString frame="876" value="A gentle head shake, then a small shrug." />
                    <KeyFrameString frame="1170" value="Back to rest. The next gesture follows shortly." />
                    <KeyFrameString frame="1254" value="A soft hologram and a downward glance." />
                    <KeyFrameString frame="1608" value="Back to rest. The next gesture follows shortly." />
                    <KeyFrameString frame="1692" value="A tiny lean, hands drawn in, and a warm thank-you." />
                    <KeyFrameString frame="2016" value="Back to rest. The next gesture follows shortly." />
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
